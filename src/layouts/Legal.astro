---
import Base from './Base.astro';
import { site } from '../data/site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <header class="page-head container">
    <span class="eyebrow">Legal</span>
    <h1 class="display h1">{title}</h1>
    <div class="page-head__meta">
      <span>Last updated<b>{site.legalUpdated}</b></span>
      <span>Operator<b>{site.legalEntity}</b></span>
    </div>
  </header>
  <article class="container legal">
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .legal { padding-bottom: var(--section); }
  .legal .prose { max-width: 72ch; }
  .legal :global(h2:first-child) { margin-top: 0; }
</style>
