---
import { disciplines } from '../data/disciplines';
const labels = disciplines.map((d) => d.name);
---

<div class="network" aria-hidden="true">
  <canvas data-network data-labels={JSON.stringify(labels)}></canvas>
</div>

<style>
  .network { position: absolute; inset: 0; }
  canvas { width: 100%; height: 100%; }
</style>

<script>
  type Node = { bx: number; by: number; x: number; y: number; r: number; phase: number; amp: number; label?: string };
  type Edge = { a: number; b: number; w: number };
  type Pulse = { edge: number; t: number; speed: number; dir: 1 | -1 };

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const labels: string[] = JSON.parse(canvas.dataset.labels || '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1;
    let nodes: Node[] = [];
    let edges: Edge[] = [];
    const pulses: Pulse[] = [];
    let bridge = { a: 0, b: 3, born: 0 };

    // Deterministic pseudo random so the layout is stable between reloads.
    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

    function layout() {
      seed = 7;
      const rect = canvas.getBoundingClientRect();
      w = rect.width; h = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cx = w * 0.5, cy = h * 0.5;
      // Leave room on both sides for labels.
      const rx = Math.max(60, Math.min(w * 0.5 - 130, 380)), ry = Math.min(h * 0.4, 300);
      nodes = labels.map((label, i) => {
        const ang = -Math.PI / 2 + (i / labels.length) * Math.PI * 2 + (rand() - 0.5) * 0.25;
        const rr = 0.85 + rand() * 0.2;
        return { bx: cx + Math.cos(ang) * rx * rr, by: cy + Math.sin(ang) * ry * rr, x: 0, y: 0, r: 3, phase: rand() * 6.28, amp: 6 + rand() * 6, label };
      });
      const majors = nodes.length;
      // Minor concept nodes scattered through the field.
      for (let i = 0; i < 26; i++) {
        const ang = rand() * Math.PI * 2;
        const dist = Math.sqrt(rand()) * 1.15;
        nodes.push({ bx: cx + Math.cos(ang) * rx * dist, by: cy + Math.sin(ang) * ry * dist, x: 0, y: 0, r: 1.4, phase: rand() * 6.28, amp: 4 + rand() * 8 });
      }
      edges = [];
      for (let i = 0; i < majors; i++) for (let j = i + 1; j < majors; j++) edges.push({ a: i, b: j, w: 1 });
      for (let i = majors; i < nodes.length; i++) {
        const near = nodes
          .map((n, j) => ({ j, d: Math.hypot(n.bx - nodes[i].bx, n.by - nodes[i].by) }))
          .filter((o) => o.j !== i)
          .sort((p, q) => p.d - q.d)
          .slice(0, 2);
        near.forEach((o) => edges.push({ a: i, b: o.j, w: 0.5 }));
      }
    }

    function position(t: number) {
      for (const n of nodes) {
        n.x = n.bx + Math.sin(t * 0.00035 + n.phase) * n.amp;
        n.y = n.by + Math.cos(t * 0.00028 + n.phase * 1.3) * n.amp;
      }
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, w, h);
      position(reduce ? 0 : t);

      // Edges
      for (const e of edges) {
        const A = nodes[e.a], B = nodes[e.b];
        ctx!.strokeStyle = e.w === 1 ? 'rgba(156,182,238,0.10)' : 'rgba(156,182,238,0.07)';
        ctx!.lineWidth = 1;
        ctx!.beginPath(); ctx!.moveTo(A.x, A.y); ctx!.lineTo(B.x, B.y); ctx!.stroke();
      }

      // The highlighted bridge between two disciplines.
      const age = reduce ? 1 : Math.min(1, (t - bridge.born) / 1200);
      const A = nodes[bridge.a], B = nodes[bridge.b];
      const grad = ctx!.createLinearGradient(A.x, A.y, B.x, B.y);
      grad.addColorStop(0, 'rgba(104,144,230,0.9)');
      grad.addColorStop(1, 'rgba(200,214,244,0.9)');
      ctx!.strokeStyle = grad;
      ctx!.lineWidth = 1.25;
      ctx!.beginPath();
      ctx!.moveTo(A.x, A.y);
      ctx!.lineTo(A.x + (B.x - A.x) * age, A.y + (B.y - A.y) * age);
      ctx!.stroke();

      // Pulses travelling along edges.
      if (!reduce) {
        if (pulses.length < 9 && Math.random() < 0.04) {
          pulses.push({ edge: Math.floor(Math.random() * edges.length), t: 0, speed: 0.0025 + Math.random() * 0.004, dir: Math.random() > 0.5 ? 1 : -1 });
        }
        for (let i = pulses.length - 1; i >= 0; i--) {
          const p = pulses[i];
          p.t += p.speed;
          if (p.t >= 1) { pulses.splice(i, 1); continue; }
          const e = edges[p.edge];
          const P = nodes[p.dir === 1 ? e.a : e.b], Q = nodes[p.dir === 1 ? e.b : e.a];
          const x = P.x + (Q.x - P.x) * p.t, y = P.y + (Q.y - P.y) * p.t;
          const tail = Math.max(0, p.t - 0.08);
          const tx = P.x + (Q.x - P.x) * tail, ty = P.y + (Q.y - P.y) * tail;
          const g = ctx!.createLinearGradient(tx, ty, x, y);
          g.addColorStop(0, 'rgba(200,214,244,0)');
          g.addColorStop(1, 'rgba(200,214,244,0.75)');
          ctx!.strokeStyle = g;
          ctx!.lineWidth = 1.25;
          ctx!.beginPath(); ctx!.moveTo(tx, ty); ctx!.lineTo(x, y); ctx!.stroke();
        }
        if (t - bridge.born > 3400) {
          let a = Math.floor(Math.random() * labels.length), b = Math.floor(Math.random() * labels.length);
          if (a === b) b = (b + 2) % labels.length;
          bridge = { a, b, born: t };
        }
      }

      // Nodes and labels
      ctx!.font = '500 10.5px "IBM Plex Mono", ui-monospace, monospace';
      ctx!.textBaseline = 'middle';
      nodes.forEach((n, i) => {
        const active = i === bridge.a || i === bridge.b;
        if (n.label) {
          ctx!.strokeStyle = active ? 'rgba(200,214,244,0.55)' : 'rgba(156,182,238,0.22)';
          ctx!.lineWidth = 1;
          ctx!.beginPath(); ctx!.arc(n.x, n.y, 9, 0, Math.PI * 2); ctx!.stroke();
          ctx!.fillStyle = active ? '#e8e5dd' : '#6890e6';
          ctx!.beginPath(); ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx!.fill();
          const right = n.x >= w / 2;
          ctx!.textAlign = right ? 'left' : 'right';
          ctx!.fillStyle = active ? 'rgba(232,229,221,0.95)' : 'rgba(154,166,184,0.75)';
          ctx!.fillText(n.label.toUpperCase(), n.x + (right ? 18 : -18), n.y);
        } else {
          ctx!.fillStyle = 'rgba(156,182,238,0.45)';
          ctx!.beginPath(); ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx!.fill();
        }
      });
    }

    layout();
    let frame = 0;
    const loop = (t: number) => {
      if (!canvas.isConnected) return; // page changed, stop.
      draw(t);
      if (!reduce) frame = requestAnimationFrame(loop);
    };
    frame = requestAnimationFrame(loop);

    const ro = new ResizeObserver(() => { layout(); if (reduce) draw(0); });
    ro.observe(canvas);
    document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(frame); ro.disconnect(); }, { once: true });
    document.fonts?.ready.then(() => reduce && draw(0));
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLCanvasElement>('[data-network]').forEach(start);
  });
</script>
