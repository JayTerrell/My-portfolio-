---
// Build time SVG charts. One series per chart, one hue, recessive axes.
import type { Study } from '../data/research';
interface Props { chart: Study['chart']; title: string }
const { chart, title } = Astro.props;

const W = 800, H = 420;
const m = { top: 24, right: 24, bottom: 48, left: 56 };
const iw = W - m.left - m.right, ih = H - m.top - m.bottom;

const niceMax = (v: number) => {
  const p = Math.pow(10, Math.floor(Math.log10(v)));
  const n = v / p;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p;
};
const fmt = (v: number) => (v === 0 ? '0' : Math.abs(v) < 1 ? v.toFixed(2) : Number.isInteger(v) ? String(v) : v.toFixed(1));

let rows: { k: string; v: string }[] = [];
let body = '';
let ticks: { y: number; label: string }[] = [];
let xTicks: { x: number; label: string }[] = [];
let marks: { x: number; y: number; w?: number; h?: number; tip: string; kind: string }[] = [];
let linePath = '';
let bars: { y: number; h: number; w: number; label: string; value: number }[] = [];
let xLabel = '', yLabel = '';

if (chart.type === 'line') {
  const max = niceMax(Math.max(...chart.points.map((p) => p.y)) * 1.1);
  const sx = (i: number) => m.left + (i / (chart.points.length - 1)) * iw;
  const sy = (v: number) => m.top + ih - (v / max) * ih;
  ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => ({ y: sy(max * f), label: fmt(max * f) }));
  xTicks = chart.points.map((p, i) => ({ x: sx(i), label: p.x }));
  linePath = chart.points.map((p, i) => `${i ? 'L' : 'M'}${sx(i).toFixed(1)},${sy(p.y).toFixed(1)}`).join(' ');
  marks = chart.points.map((p, i) => ({ x: sx(i), y: sy(p.y), tip: `${p.x}: ${fmt(p.y)} ${chart.unit}`, kind: 'point' }));
  rows = chart.points.map((p) => ({ k: p.x, v: `${fmt(p.y)} ${chart.unit}` }));
  xLabel = chart.xLabel; yLabel = `${chart.yLabel} (${chart.unit})`;
}
if (chart.type === 'bar') {
  const labelW = 150;
  const max = niceMax(Math.max(...chart.bars.map((b) => b.value)));
  const band = ih / chart.bars.length;
  const bw = (v: number) => (v / max) * (iw - labelW + m.left - 40);
  bars = chart.bars.map((b, i) => ({ y: m.top + i * band + band * 0.22, h: band * 0.56, w: bw(b.value), label: b.label, value: b.value }));
  rows = chart.bars.map((b) => ({ k: b.label, v: `${b.value}${chart.unit.startsWith('%') ? '' : ' '}${chart.unit}` }));
}
if (chart.type === 'scatter') {
  const xmax = Math.max(...chart.points.map((p) => p.x)) + 1;
  const ymax = niceMax(Math.max(...chart.points.map((p) => p.y)) * 1.1);
  const sx = (v: number) => m.left + (v / xmax) * iw;
  const sy = (v: number) => m.top + ih - (v / ymax) * ih;
  ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => ({ y: sy(ymax * f), label: fmt(ymax * f) }));
  xTicks = Array.from({ length: xmax - 1 }, (_, i) => ({ x: sx(i + 1), label: String(i + 1) }));
  // Small horizontal jitter so overlapping points stay visible.
  const seen: Record<number, number> = {};
  marks = chart.points.map((p) => {
    const n = (seen[p.x] = (seen[p.x] ?? -1) + 1);
    const jitter = (n % 2 ? 1 : -1) * Math.ceil(n / 2) * 7;
    return { x: sx(p.x) + jitter, y: sy(p.y), tip: `${p.x} disciplines, error ${fmt(p.y)}`, kind: 'dot' };
  });
  rows = chart.points.map((p) => ({ k: `${p.x} disciplines`, v: fmt(p.y) }));
  xLabel = chart.xLabel; yLabel = chart.yLabel;
}
const labelW = 150;
---

<figure class="chart skeleton" data-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
    {ticks.map((t) => (
      <g>
        <line x1={m.left} x2={W - m.right} y1={t.y} y2={t.y} class="grid" />
        <text x={m.left - 12} y={t.y} class="tick" text-anchor="end" dominant-baseline="middle">{t.label}</text>
      </g>
    ))}
    {xTicks.map((t) => <text x={t.x} y={H - m.bottom + 24} class="tick" text-anchor="middle">{t.label}</text>)}
    {xLabel && <text x={W - m.right} y={H - 6} class="axis-label" text-anchor="end">{xLabel}</text>}
    {yLabel && <text x={m.left} y={12} class="axis-label">{yLabel}</text>}

    {chart.type === 'line' && (
      <g>
        <line class="crosshair" x1="0" x2="0" y1={m.top} y2={m.top + ih} data-crosshair />
        <path d={linePath} class="line" pathLength="1" />
        {marks.map((p) => <circle cx={p.x} cy={p.y} r="4" class="point" data-tip={p.tip} />)}
        {marks.map((p, i) => (
          <rect class="hit" x={p.x - iw / (marks.length - 1) / 2} y={m.top} width={iw / (marks.length - 1)} height={ih} data-tip={p.tip} data-idx={i} data-x={p.x} />
        ))}
      </g>
    )}

    {chart.type === 'bar' && bars.map((b) => (
      <g class="bar-row" data-tip={`${b.label}: ${b.value}%`}>
        <text x={m.left - 40 + labelW - 14} y={b.y + b.h / 2} class="bar-label" text-anchor="end" dominant-baseline="middle">{b.label}</text>
        <rect x={m.left - 40 + labelW} y={b.y} width={b.w} height={b.h} class="bar" />
        <text x={m.left - 40 + labelW + b.w + 10} y={b.y + b.h / 2} class="bar-value" dominant-baseline="middle">{b.value}%</text>
        <rect x={m.left - 40} y={b.y - 6} width={W - m.left} height={b.h + 12} class="hit" />
      </g>
    ))}

    {chart.type === 'scatter' && marks.map((p) => (
      <g data-tip={p.tip}>
        <circle cx={p.x} cy={p.y} r="5" class="dot" />
        <circle cx={p.x} cy={p.y} r="14" class="hit" />
      </g>
    ))}
  </svg>
  <div class="chart__tip mono" data-tip-el hidden></div>
  <details class="chart__table">
    <summary class="mono">View data table</summary>
    <table>
      <tbody>{rows.map((r) => <tr><th scope="row">{r.k}</th><td>{r.v}</td></tr>)}</tbody>
    </table>
  </details>
</figure>

<style>
  .chart { position: relative; border: 1px solid var(--line); padding: clamp(16px, 2.5vw, 32px); background: var(--surface); }
  .chart.skeleton svg { opacity: 0; }
  .chart svg { width: 100%; height: auto; overflow: visible; transition: opacity 0.6s var(--ease-out); }
  .chart.is-loaded svg { opacity: 1; }
  .grid { stroke: rgba(200, 214, 240, 0.08); stroke-width: 1; }
  .tick, .axis-label, .bar-label, .bar-value { font-family: var(--font-mono); font-size: 12px; fill: var(--text-faint); }
  .axis-label { letter-spacing: 0.08em; text-transform: uppercase; font-size: 11px; }
  .bar-label { fill: var(--text-muted); font-family: var(--font-body); font-size: 14px; }
  .bar-value { fill: var(--text); }
  .line { fill: none; stroke: var(--blue-400); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .is-loaded .line { stroke-dashoffset: 0; transition: stroke-dashoffset 1.6s var(--ease-out) 0.2s; }
  .point { fill: var(--ink-850); stroke: var(--blue-300); stroke-width: 2; opacity: 0; }
  .point.is-active { opacity: 1; }
  .crosshair { stroke: var(--line-strong); stroke-width: 1; opacity: 0; }
  .crosshair.is-active { opacity: 1; }
  .bar { fill: var(--blue-500); transform-box: fill-box; transform-origin: left; transform: scaleX(0); }
  .is-loaded .bar { transform: scaleX(1); transition: transform 1.1s var(--ease-out) 0.15s; }
  .bar-row:hover .bar { fill: var(--blue-400); }
  .dot { fill: var(--blue-400); stroke: var(--ink-850); stroke-width: 2; opacity: 0; }
  .is-loaded .dot { opacity: 1; transition: opacity 0.6s var(--ease-out) 0.3s; }
  g:hover > .dot { fill: var(--blue-200); }
  .hit { fill: transparent; cursor: crosshair; }

  .chart__tip {
    position: absolute;
    pointer-events: none;
    padding: 8px 12px;
    background: rgba(6, 13, 25, 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-strong);
    color: var(--text-strong);
    font-size: 12px;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 12px));
  }
  .chart__table { margin-top: 16px; border-top: 1px solid var(--line); padding-top: 12px; }
  .chart__table summary { cursor: pointer; font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); }
  .chart__table summary:hover { color: var(--text); }
  .chart__table table { margin-top: 12px; width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  .chart__table th, .chart__table td { text-align: left; padding: 6px 0; border-bottom: 1px solid var(--line); font-weight: 400; color: var(--text-muted); }
  .chart__table td { text-align: right; font-family: var(--font-mono); color: var(--text); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const figures = document.querySelectorAll<HTMLElement>('[data-chart]');
    // Skeleton holds until the chart scrolls into view, then the marks draw in.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          window.setTimeout(() => e.target.classList.add('is-loaded'), 350);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.25 });

    figures.forEach((fig) => {
      io.observe(fig);
      const tip = fig.querySelector<HTMLElement>('[data-tip-el]')!;
      const svg = fig.querySelector('svg')!;
      const cross = fig.querySelector<SVGLineElement>('[data-crosshair]');
      const points = fig.querySelectorAll<SVGCircleElement>('.point');

      const show = (target: Element, evt: PointerEvent) => {
        const host = target.closest('[data-tip]') as HTMLElement | null;
        if (!host) return;
        tip.textContent = host.dataset.tip || '';
        tip.hidden = false;
        const box = fig.getBoundingClientRect();
        let x = evt.clientX - box.left, y = evt.clientY - box.top;
        if (host.dataset.idx !== undefined && cross) {
          const idx = Number(host.dataset.idx);
          const pt = points[idx];
          const scale = svg.getBoundingClientRect().width / svg.viewBox.baseVal.width;
          const svgBox = svg.getBoundingClientRect();
          x = svgBox.left - box.left + Number(pt.getAttribute('cx')) * scale;
          y = svgBox.top - box.top + Number(pt.getAttribute('cy')) * scale;
          cross.setAttribute('x1', pt.getAttribute('cx')!);
          cross.setAttribute('x2', pt.getAttribute('cx')!);
          cross.classList.add('is-active');
          points.forEach((p, i) => p.classList.toggle('is-active', i === idx));
        }
        tip.style.left = `${x}px`;
        tip.style.top = `${y}px`;
      };
      svg.addEventListener('pointermove', (e) => {
        const t = e.target as Element;
        if (t.closest('[data-tip]')) show(t, e);
      });
      svg.addEventListener('pointerleave', () => {
        tip.hidden = true;
        cross?.classList.remove('is-active');
        points.forEach((p) => p.classList.remove('is-active'));
      });
    });
  });
</script>
