---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Chart from '../components/Chart.astro';
import { studies } from '../data/research';
---

<Base title="Research" description="Data research: questions worth asking, honest methods, and what the numbers say.">
  <PageHead eyebrow="Data research" meta={[{ label: 'Studies', value: String(studies.length) }, { label: 'Method', value: 'Question first' }]}>
    <Fragment slot="title">What the data <em>actually</em> says.</Fragment>
    <Fragment slot="lede">Each study starts with a question a decision maker would care about, then follows the evidence wherever it goes.</Fragment>
  </PageHead>

  <section class="container">
    {studies.map((s) => (
      <article class="study" id={s.id} data-reveal>
        <div class="study__copy">
          <span class="index-num">{s.index}</span>
          <h2 class="display study__title">{s.title}</h2>
          <dl class="study__facts">
            <div><dt class="mono">Question</dt><dd>{s.question}</dd></div>
            <div><dt class="mono">Finding</dt><dd>{s.finding}</dd></div>
            <div><dt class="mono">Method</dt><dd>{s.method}</dd></div>
            <div><dt class="mono">Source</dt><dd>{s.source}</dd></div>
          </dl>
        </div>
        <Chart chart={s.chart} title={s.title} />
      </article>
    ))}
  </section>
</Base>

<style>
  .study {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(48px, 6vw, 96px) 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .study__title { font-size: var(--fs-xl); margin: 16px 0 28px; }
  .study__facts div { padding: 14px 0; border-top: 1px solid var(--line); font-size: var(--fs-sm); }
  .study__facts dt { font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .study__facts dd { color: var(--text-muted); }
  @media (max-width: 900px) { .study { grid-template-columns: 1fr; } }
</style>
